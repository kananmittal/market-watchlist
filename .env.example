# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env - it is gitignored.
# This file contains placeholders only.
# ---------------------------------------------------------------------------

# ===== REQUIRED =====

# Groq API key for the copilot. Get one free at https://console.groq.com/keys
# The shorthand name GROQ is also accepted.
GROQ_API_KEY=gsk_your_groq_api_key_here

# MongoDB connection string.
#   local dev  : mongodb://localhost:27017
#   production : MongoDB Atlas SRV string (see DEPLOYMENT.md)
# DATABASE_URL is accepted as an alias when it holds a mongodb:// URI.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=market_watchlist

# Secret used to sign session tokens. Use at least 32 random characters.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=replace_with_at_least_32_random_characters

# ===== FRONTEND (build-time, safe to expose) =====

# Public URL of the backend API. No trailing slash.
#   local dev  : http://localhost:8000
#   production : https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===== OPTIONAL =====

# Comma-separated browser origins allowed to call the API.
# Any *.vercel.app origin is always permitted, so preview deploys work.
CORS_ORIGINS=http://localhost:3000

# Groq model. Must be one your account can access; list them at
# https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# development | production. Production emits JSON logs.
APP_ENV=development
LOG_LEVEL=INFO

# Serve deterministic synthetic market data instead of calling providers.
# Lets the whole product be demonstrated with no market credentials.
DEMO_MODE=false

# Market data provider order, first match wins.
# "demo" is always available as a last-resort fallback.
MARKET_PROVIDER_ORDER=yfinance,jugaad,demo

# Percentage disagreement between providers that raises DATA_CONFLICT.
PRICE_CONFLICT_TOLERANCE_PCT=1.0

# ===== OPTIONAL: Upstox =====
# Not required. yfinance plus the demo provider cover everything the product
# needs; leave these blank unless you are deliberately enabling Upstox.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=
UPSTOX_ACCESS_TOKEN=
